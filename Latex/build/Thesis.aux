\newlabel{fig:risk_indices}{{\caption@xref {fig:risk_indices}{ on input line 682}}{26}{Custom risk index dynamics}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Custom and Reference Sentiment-Based Risk Indices, 1997 Q1 -- 2024 Q4. The upper panel displays the FinBERT and VADER custom sentiment indices constructed in this thesis. The lower panel shows the reference sentiment-based benchmarks, comprising the Economic Policy Uncertainty Index (EPUI) and the Shapiro News Sentiment Index (NSI). All series are Z-score standardised. Shaded areas denote NBER recession episodes, labelled by the dot-com bubble, the Global Financial Crisis, and the COVID-19 pandemic.}}{26}{figure.caption.19}\protected@file@percent }
\newlabel{fig:risk_indices_ts}{{\caption@xref {fig:risk_indices_ts}{ on input line 700}}{28}{Custom risk index dynamics}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Custom and Reference Time Series-Based Risk Indices, 1997 Q1 -- 2024 Q4. The upper panel displays the Custom Risk Index and the Custom Mix Index constructed in this thesis via the hierarchical two-stage PCA procedure. The lower panel shows the reference time series-based benchmarks, comprising the STLFSI, NFCI, KCFSI, and VIX. All series are Z-score standardised. Shaded areas denote NBER recession episodes, labelled by the dot-com bubble, the Global Financial Crisis, and the COVID-19 pandemic.}}{28}{figure.caption.20}\protected@file@percent }
\newlabel{fig:risk_index}{{\caption@xref {fig:risk_index}{ on input line 715}}{30}{Custom risk index dynamics}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Pairwise Correlation Matrix of All Risk Indices and the Fed Shadow Rate. The matrix displays Pearson correlations between all risk indices used in the analysis, including the custom time series-based index, the custom mixed index, the custom sentiment indices (VADER and FinBERT), the Federal Reserve benchmark indices (STLFSI, NFCI, KCFSI), the VIX, the EPU Index, the Shapiro News Sentiment Index, and the Wu--Xia Federal Reserve shadow rate. Red shading indicates positive correlation and blue shading indicates negative correlation, with intensity proportional to the magnitude of the coefficient.}}{30}{figure.caption.21}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2.2}Granger Causality Results}{31}{section.2.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2.1}{\ignorespaces Granger Causality Results Across Financial Sector Subsectors. The table reports pairwise Granger causality test results between each risk index and the composite factor for each financial subsector. The columns show the p-value for the direction from risk index to sectoral factor, the reverse direction, the fixed lag length, and the implied causality direction. Results are presented for the banking sector, shadow banking core, shadow banking broad, and hedge fund subsectors. Rows are sorted within each sector by the strength of the dominant causality direction. All tests use a fixed lag length of four quarters.}}{32}{table.caption.22}\protected@file@percent }
\newlabel{tab:granger_causality}{{2.1}{32}{Granger Causality Results Across Financial Sector Subsectors. The table reports pairwise Granger causality test results between each risk index and the composite factor for each financial subsector. The columns show the p-value for the direction from risk index to sectoral factor, the reverse direction, the fixed lag length, and the implied causality direction. Results are presented for the banking sector, shadow banking core, shadow banking broad, and hedge fund subsectors. Rows are sorted within each sector by the strength of the dominant causality direction. All tests use a fixed lag length of four quarters}{table.caption.22}{}}
